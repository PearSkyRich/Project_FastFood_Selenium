      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "let json = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Login successful\", function () {\r",
                  "    pm.expect(json.username).to.not.be.undefined;\r",
                  "    pm.expect(json.fullName).to.not.be.undefined;\r",
                  "    pm.expect(json.role).to.not.be.undefined;\r",
                  "});\r",
                  "\r",
                  "// Lưu thông tin người dùng để dùng cho các request khác\r",
                  "pm.environment.set(\"username\", json.username);\r",
                  "pm.environment.set(\"fullName\", json.fullName);\r",
                  "pm.environment.set(\"role\", json.role);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
